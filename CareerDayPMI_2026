<style>
  :root{
    --ink: #0e3654;
    --ink-2: #123f66;
    --ink-3: #0a2c46;
    --paper: #eaf2f8;
    --paper-dim: #9fbbd1;
    --paper-dimmer: #6f92ac;
    --brass: #c9a15a;
    --redline: #c1443b;
    --line: rgba(234,242,248,0.16);
    --line-strong: rgba(234,242,248,0.32);
    --display: 'Big Shoulders Display', sans-serif;
    --body: 'IBM Plex Sans', -apple-system, sans-serif;
    --mono: 'IBM Plex Mono', ui-monospace, monospace;
    --max: 920px;
  }

  *{ box-sizing: border-box; }
  html{ scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce){
    html{ scroll-behavior: auto; }
    *{ animation-duration: 0.001ms !important; animation-iteration-count: 1 !important; transition-duration: 0.001ms !important; }
  }

  body{
    margin: 0;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--body);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  a{ color: var(--brass); text-decoration: none; }
  a:hover{ text-decoration: underline; }
  a:focus-visible, button:focus-visible{
    outline: 2px solid var(--brass);
    outline-offset: 3px;
  }

  .grid-bg{
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 42px 42px;
    opacity: 0.35;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, black 40%, transparent 90%);
  }

  .wrap{
    position: relative;
    z-index: 1;
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 28px;
  }

  /* ---------- TITLE BLOCK (hero) ---------- */
  .title-block{
    border-bottom: 2px solid var(--line-strong);
    padding-top: 56px;
    padding-bottom: 40px;
  }
  .tb-eyebrow{
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brass);
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 22px;
  }
  .tb-eyebrow::before{
    content: "";
    width: 26px;
    height: 1px;
    background: var(--brass);
    display: inline-block;
  }
  .tb-name{
    font-family: var(--display);
    font-weight: 800;
    letter-spacing: 0.01em;
    font-size: clamp(42px, 8vw, 76px);
    line-height: 0.98;
    margin: 0 0 6px 0;
    text-transform: uppercase;
  }
  .tb-role{
    font-family: var(--body);
    font-weight: 500;
    font-size: clamp(16px, 2.4vw, 20px);
    color: var(--paper-dim);
    margin: 0 0 34px 0;
    max-width: 46ch;
  }

  .tb-fields{
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line-strong);
    border-left: 1px solid var(--line-strong);
  }
  .tb-field{
    border-right: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
    padding: 12px 16px;
  }
  .tb-field dt{
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--paper-dimmer);
    margin: 0 0 6px 0;
  }
  .tb-field dd{
    font-family: var(--mono);
    font-size: 13px;
    margin: 0;
    color: var(--paper);
  }
  .tb-field.status dd{ color: var(--brass); }

  .tb-cta{
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 28px;
  }
  .btn{
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    padding: 12px 20px;
    border: 1px solid var(--line-strong);
    color: var(--paper);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
  }
  .btn:hover{
    border-color: var(--brass);
    color: var(--ink);
    background: var(--brass);
    text-decoration: none;
  }
  .btn.primary{
    background: var(--brass);
    color: var(--ink-3);
    border-color: var(--brass);
    font-weight: 600;
  }
  .btn.primary:hover{ background: var(--paper); border-color: var(--paper); }

  /* ---------- SHEETS (sections) ---------- */
  .sheet{
    padding: 64px 0;
    border-bottom: 1px solid var(--line);
  }
  .sheet-head{
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    margin-bottom: 30px;
    flex-wrap: wrap;
  }
  .sheet-title{
    font-family: var(--display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(24px, 3.6vw, 32px);
    letter-spacing: 0.01em;
    margin: 0;
  }
  .sheet-tag{
    font-family: var(--mono);
    font-size: 12px;
    color: var(--paper-dimmer);
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .lede{
    max-width: 62ch;
    color: var(--paper-dim);
    font-size: 17px;
  }
  .lede strong{ color: var(--paper); font-weight: 600; }

  /* ---------- REVISION HISTORY (experience) ---------- */
  .rev-table{ width: 100%; border-collapse: collapse; margin-top: 8px; }
  .rev-table thead th{
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--paper-dimmer);
    text-align: left;
    padding: 0 14px 12px 0;
    border-bottom: 1px solid var(--line-strong);
    font-weight: 500;
  }
  .rev-table tbody tr{
    border-bottom: 1px solid var(--line);
    transition: background 0.15s ease;
  }
  .rev-table tbody tr:hover{ background: rgba(201,161,90,0.06); }
  .rev-table td{
    padding: 18px 14px 18px 0;
    vertical-align: top;
  }
  .rev-letter{
    font-family: var(--mono);
    font-size: 20px;
    font-weight: 600;
    color: var(--brass);
    width: 1%;
    white-space: nowrap;
  }
  .rev-date{
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--paper-dimmer);
    width: 1%;
    white-space: nowrap;
    padding-right: 28px !important;
  }
  .rev-desc-title{
    font-weight: 600;
    color: var(--paper);
    margin: 0 0 4px 0;
    font-size: 15.5px;
  }
  .rev-desc-body{
    color: var(--paper-dim);
    font-size: 14.5px;
    margin: 0;
    max-width: 52ch;
  }
  .rev-desc-body .num{
    font-family: var(--mono);
    color: var(--brass);
  }

  /* ---------- DETAIL CALLOUT (research) ---------- */
  .detail-grid{
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 40px;
    align-items: start;
  }
  .detail-copy p{ color: var(--paper-dim); font-size: 15.5px; }
  .detail-copy .journal{
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--redline);
    letter-spacing: 0.04em;
    border: 1px solid rgba(193,68,59,0.5);
    display: inline-block;
    padding: 6px 12px;
    margin-top: 6px;
  }
  .stat-row{
    display: flex;
    gap: 28px;
    margin: 22px 0 26px 0;
    flex-wrap: wrap;
  }
  .stat{ min-width: 110px; }
  .stat-num{
    font-family: var(--display);
    font-weight: 700;
    font-size: 34px;
    color: var(--brass);
    line-height: 1;
  }
  .stat-label{
    font-family: var(--mono);
    font-size: 11px;
    color: var(--paper-dimmer);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-top: 6px;
  }

  .method-panel{
    border: 1px solid var(--line-strong);
    padding: 22px 22px 20px 22px;
    background: rgba(234,242,248,0.02);
  }
  .panel-title{
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--paper-dimmer);
    margin-bottom: 4px;
  }
  .panel-sub{
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--paper-dimmer);
    margin-bottom: 20px;
    opacity: 0.8;
  }
  .method-list{
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 15px;
  }
  .method-list li{
    display: flex;
    gap: 14px;
    align-items: baseline;
    font-size: 13.5px;
    color: var(--paper-dim);
    padding-bottom: 15px;
    border-bottom: 1px solid var(--line);
  }
  .method-list li:last-child{ border-bottom: none; padding-bottom: 0; }
  .step-num{
    font-family: var(--mono);
    font-size: 12px;
    color: var(--brass);
    flex-shrink: 0;
  }

  /* ---------- BILL OF MATERIALS (skills) ---------- */
  .bom-table{ width: 100%; border-collapse: collapse; }
  .bom-table thead th{
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--paper-dimmer);
    text-align: left;
    padding: 0 12px 10px 0;
    border-bottom: 1px solid var(--line-strong);
    font-weight: 500;
  }
  .bom-table td{
    padding: 11px 12px 11px 0;
    border-bottom: 1px solid var(--line);
    font-size: 14.5px;
  }
  .bom-item{
    font-family: var(--mono);
    color: var(--paper-dimmer);
    font-size: 12.5px;
    width: 1%;
    white-space: nowrap;
  }
  .bom-cat{
    font-family: var(--mono);
    font-size: 11px;
    color: var(--brass);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    width: 1%;
    white-space: nowrap;
    text-align: right;
  }

  /* ---------- EDUCATION ---------- */
  .edu-list{ display: flex; flex-direction: column; gap: 26px; }
  .edu-item{ display: grid; grid-template-columns: 130px 1fr; gap: 20px; }
  .edu-date{
    font-family: var(--mono);
    font-size: 12px;
    color: var(--paper-dimmer);
    padding-top: 3px;
  }
  .edu-name{ font-weight: 600; font-size: 16.5px; margin: 0 0 4px 0; }
  .edu-sub{ color: var(--paper-dim); font-size: 14.5px; margin: 0; }
  .edu-sub .num{ font-family: var(--mono); color: var(--brass); }

  /* ---------- FOOTER / STAMP ---------- */
  footer.stamp{
    padding: 56px 0 70px 0;
    position: relative;
    z-index: 1;
  }
  .stamp-inner{
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 28px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 30px;
  }
  .stamp-box{
    border: 1.5px solid var(--redline);
    color: var(--redline);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 10px 16px;
    transform: rotate(-3deg);
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .stamp-box::before{ content: "✓"; font-weight: 700; }
  .contact-links{
    font-family: var(--mono);
    font-size: 13.5px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-end;
    text-align: right;
  }
  .footer-note{
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--paper-dimmer);
    text-align: center;
    margin-top: 50px;
  }

  /* reveal on scroll */
  .reveal{ opacity: 0; transform: translateY(14px); transition: opacity 0.6s ease, transform 0.6s ease; }
  .reveal.is-visible{ opacity: 1; transform: translateY(0); }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 720px){
    .tb-fields{ grid-template-columns: repeat(2, 1fr); }
    .detail-grid{ grid-template-columns: 1fr; }
    .rev-table thead{ display: none; }
    .rev-table td{ display: block; padding: 4px 0; }
    .rev-table tr{ display: block; padding: 16px 0; }
    .rev-letter{ font-size: 16px; }
    .edu-item{ grid-template-columns: 1fr; gap: 4px; }
    .stamp-inner{ flex-direction: column; align-items: flex-start; }
    .contact-links{ align-items: flex-start; text-align: left; }
  }

  /* ---------- COMPETENCY MAP --------- */
  .comp-grid{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px 40px;
  }
  .comp-group-label{
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--paper-dimmer);
    margin-bottom: 14px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--line-strong);
  }
  .comp-tags{
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .comp-tag{
    font-family: var(--mono);
    font-size: 11.5px;
    padding: 5px 11px;
    border: 1px solid var(--line-strong);
    color: var(--paper-dim);
    letter-spacing: 0.02em;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .comp-tag:hover{
    border-color: var(--brass);
    color: var(--paper);
  }
  .comp-tag--sector{
    border-color: rgba(201,161,90,0.4);
    color: var(--brass);
  }
  @media (max-width: 720px){
    .comp-grid{ grid-template-columns: 1fr; gap: 28px; }
  }

</style>
</head>
